 SQL
+
+# Migrate stores created before realm-aware routing. SQLite has no
+# ADD COLUMN IF NOT EXISTS, so inspect the schema before each additive change.
+ensure_column() {
+  local name="$1" definition="$2"
+  if ! agmsg_sqlite "$DB" "SELECT 1 FROM pragma_table_info('messages') WHERE name='$name';" | grep -q 1; then
+    agmsg_sqlite "$DB" "ALTER TABLE messages ADD COLUMN $name $definition;"
+  fi
+}
+
+ensure_column message_id "TEXT"
+ensure_column realm "TEXT NOT NULL DEFAULT 'local'"
+ensure_column thread "TEXT"
+ensure_column kind "TEXT NOT NULL DEFAULT 'message'"
+ensure_column reply_to "TEXT"
+ensure_column status "TEXT NOT NULL DEFAULT 'delivered'"
+ensure_column handled_at "TEXT"
+
+agmsg_sqlite "$DB" <<'SQL'
+CREATE UNIQUE INDEX IF NOT EXISTS idx_message_id ON messages(message_id) WHERE message_id IS NOT NULL;
+CREATE INDEX IF NOT EXISTS idx_realm_inbox ON messages(realm, team, to_agent, read_at) WHERE read_at IS NULL;
+CREATE INDEX IF NOT EXISTS idx_thread ON messages(realm, team, thread, created_at);
+SQL
