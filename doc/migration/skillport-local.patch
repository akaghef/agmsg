 agmsg_sqlite "$DB" <<'SQL'
 CREATE TABLE IF NOT EXISTS messages (
   id INTEGER PRIMARY KEY AUTOINCREMENT,
+  message_id TEXT,
+  realm TEXT NOT NULL DEFAULT 'local',
   team TEXT NOT NULL,
